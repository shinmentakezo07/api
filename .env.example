# free-pi gateway — environment configuration
# Copy to `.env` and fill in what you need. Every value here is optional;
# defaults live in src/config.js and shi.json (.env overrides shi.json).

# ── Admin UI ────────────────────────────────────────────────────────────────
# Key for http://localhost:8787/admin (sent as x-admin-key header).
# If unset, one is generated at first start and stored in .admin-key.
# ADMIN_KEY=your-secret-admin-key
# FREEPI_ADMIN_KEY=also-accepted

# ── Server ──────────────────────────────────────────────────────────────────
# Port and bind address (HOST=0.0.0.0 needed inside Docker)
# PORT=8787
# HOST=127.0.0.1

# ── Upstream ────────────────────────────────────────────────────────────────
# free-pi backend (default https://api.freepi.ai)
# FREEPI_BASE_URL=https://api.freepi.ai

# ── Client version (x-client-version) ───────────────────────────────────────
# "auto" (default) reads GET /client-version for the current min/latest and
# sends the newest, so upstream's 426 upgrade_required never reaches a client
# (it is adopted and the request is retried). Set a concrete version only to
# pin a floor for debugging; upstream can still raise it.
# FREEPI_CLIENT_VERSION=auto

# ── Logging ─────────────────────────────────────────────────────────────────
# debug | info | warn | error
# FREEPI_LOG_LEVEL=info

# ── State directory ─────────────────────────────────────────────────────────
# Where accounts.json, logs/ and .admin-key live (Docker uses /app/data)
# DATA_DIR=/app/data

# ── CLI fallback account ────────────────────────────────────────────────────
# Used when no .env / accounts.json accounts exist:
# the free-pi CLI's own signed-in token (~/.free-pi/agent/credentials.json).
# FREEPI_CREDENTIALS_FILE=/home/you/.free-pi/agent/credentials.json

# ── Accounts (each token = one free-pi account) ─────────────────────────────
# The JWT from that account's ~/.free-pi/agent/credentials.json.
# Accounts are distributed round-robin; add via the admin UI login flow too.
#
# Option A: comma-separated
# FREEPI_ACCOUNTS=eyJhbGciOi...token1...,eyJhbGciOi...token2...
#
# Option B: JSON array
# FREEPI_ACCOUNTS=["eyJ...", "eyJ..."]
#
# Option C: numbered (up to 20)
# FREEPI_TOKEN_1=
# FREEPI_TOKEN_2=
#
# These are read from the real process environment as well as this file, so
# `docker run -e FREEPI_TOKEN_1=...` works without writing a .env.

# ── Upstream sessions ───────────────────────────────────────────────────────
# free-pi allows ONE request at a time per x-session-id, so a shared id per
# account makes clients queue behind each other.
#   request      fresh id per request (default)
#   conversation stable id per conversation (system + first turn)
#   account      one stable id per account (legacy, serialising)
# FREEPI_SESSION_STRATEGY=request
