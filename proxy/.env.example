# free-pi gateway — account configuration
# Add one JWT per line pattern. Each token is one free-pi account
# (the token from that account's ~/.free-pi/agent/credentials.json).
#
# Option A: comma-separated
# FREEPI_ACCOUNTS=eyJhbGciOi...token1...,eyJhbGciOi...token2...
#
# Option B: JSON array
# FREEPI_ACCOUNTS=["eyJ...", "eyJ..."]
#
# Option C: numbered
FREEPI_TOKEN_1=
FREEPI_TOKEN_2=
